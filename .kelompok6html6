let halamanSekarang = 0;
let dataHalaman = dataProduk.halaman;

function bukaAroma(p){
  document.getElementById('namaProdukModal').textContent = p.nama;
  document.getElementById('aromaAtas').textContent = p.atas;
  document.getElementById('aromaTengah').textContent = p.tengah;
  document.getElementById('aromaBawah').textContent = p.bawah;
  document.getElementById('modalAroma').style.display = 'flex';
}
function tutupAroma(){
  document.getElementById('modalAroma').style.display = 'none';
}

function muatHalaman(){
  document.getElementById('namaKelompok').textContent = "🌿 KELOMPOK 6 — REMPAH / TIMUR TENGAH";
  tampilHalaman();
}

function tampilHalaman(){
  const totalHalaman = dataHalaman.length;
  const produk = dataHalaman[halamanSekarang];
  let html = '';
  produk.forEach(p => {
    html += `<tr class="baris-produk" onclick='bukaAroma(${JSON.stringify(p).replace(/'/g,"\\'")})'>
      <td>${p.kode}</td>
      <td>${p.nama}</td>
      <td>${p.harga.toLocaleString('id-ID')}</td>
      <td style="text-align:center" onclick="event.stopPropagation()">
        <button class="btn-beli" onclick="tambahKeKeranjang('${p.nama.replace(/'/g,"\\'")}', ${p.harga})">+</button>
      </td>
    </tr>`;
  });
  document.getElementById('isiTabel').innerHTML = html;
  document.getElementById('infoHalaman').textContent = `Halaman ${halamanSekarang+1} dari ${totalHalaman}`;
  document.getElementById('btnSebelumnya').disabled = halamanSekarang <= 0;
  document.getElementById('btnSelanjutnya').disabled = halamanSekarang >= totalHalaman.length-1;
}

function halamanSebelumnya(){
  if(halamanSekarang > 0){ halamanSekarang--; tampilHalaman(); window.scrollTo({top:0,behavior:'smooth'}); }
}
function halamanSelanjutnya(){
  if(halamanSekarang < dataHalaman.length-1){ halamanSekarang++; tampilHalaman(); window.scrollTo({top:0,behavior:'smooth'}); }
}

