<!doctype html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>🪵 KAYU — Woody | ATLANTIC PERFUME</title>
 <style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Georgia,serif}
html,body{width:100%;overflow-x:hidden}
body{background:#0f2040;color:#fff;line-height:1.4;padding-top:80px}
a{text-decoration:none}
.menu-latar{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:999}
.menu-kotak{position:fixed;top:0;right:-300px;width:280px;height:100%;background:#fff;z-index:1000;transition:right .3s}
.menu-tutup{text-align:right;padding:15px 20px;font-size:22px;cursor:pointer;color:#333}
.menu-judul{padding:10px 20px;font-weight:bold;color:#0f2040;border-bottom:1px solid #eee}
.menu-item{display:block;padding:12px 20px;color:#333;border-bottom:1px solid #f5f5f5}
.menu-item:hover{background:#e6edff}
.menu-item.aktif{background:linear-gradient(90deg, #0a1630, #142850);color:#fff;font-weight:bold;border-left:4px solid #ffd700}
table{width:100%;border-collapse:separate;border-spacing:0;background:rgba(255,255,255,0.04);border-radius:8px;overflow:hidden}
th{padding:8px 6px;text-align:left;background:rgba(255,255,255,0.08);border-bottom:1px solid rgba(255,255,255,0.12);font-size:14px;color:#ffd700}
td{padding:7px 6px;border-bottom:1px solid rgba(255,255,255,0.06);font-size:14px;word-wrap:break-word;white-space:normal}
.baris-produk{cursor:pointer;transition:all .2s}
.baris-produk:hover{background:rgba(255,255,255,0.08) !important;border-left:3px solid #ffd700}
.btn-beli{background:rgba(0,170,85,0.9);color:#fff;border:none;padding:5px 9px;border-radius:4px;cursor:pointer;font-size:15px;font-weight:bold;transition:all .2s}
.btn-beli:hover{background:rgba(0,204,102,1)}
.nav-halaman{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding:10px 0}
.btn-nav{width:80px;padding:8px 0;background:rgba(255,255,255,0.06);color:#fff;border-radius:6px;border:1px solid rgba(255,255,255,0.12);cursor:pointer;font-size:18px;font-weight:bold;text-align:center;transition:all .2s}
.btn-nav:disabled{opacity:0.25;cursor:not-allowed}
.info-halaman{font-size:14px;color:#ffd700;font-weight:bold}
/* === KOTAK KETERANGAN AROMA — LATAR SAMAR TEMBUS PANDANG === */
.latar-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;align-items:center;justify-content:center}
.kotak-modal{background:rgba(255,255,255,0.12);backdrop-filter:blur(8px);color:#fff;padding:18px;border-radius:12px;width:92%;max-width:400px;border:1px solid rgba(255,255,255,0.18);box-shadow:0 8px 32px rgba(0,0,0,0.2)}
.judul-modal{font-size:17px;font-weight:bold;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,0.15);color:#ffd700}
.baris-aroma{padding:8px 0;border-bottom:1px dashed rgba(255,255,255,0.1);font-size:14px}
.label-aroma{font-weight:bold;display:inline-block;width:85px;color:#ffd700}
.tutup-modal{margin-top:14px;width:100%;padding:10px;background:rgba(15,32,64,0.7);color:#fff;border:1px solid rgba(255,255,255,0.2);border-radius:8px;cursor:pointer;font-size:15px;font-weight:bold}
.tutup-modal:hover{background:rgba(15,32,64,0.9)}
 </style>
</head>
