      {kode:"B 0303", nama:"Givenchy Gentleman", harga:72000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0401", nama:"Gucci Guilty", harga:78000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0403", nama:"Gucci By Gucci", harga:78000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0502", nama:"Hugo Boss Man", harga:66000, atas:"Jeruk, Rempah, Buah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0503", nama:"Issey Miyake L'Eau", harga:72000, atas:"Jeruk, Air Segar, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0602", nama:"Jean Paul Gaultier", harga:78000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0703", nama:"Lacoste White", harga:60000, atas:"Jeruk, Buah Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Lembut"},
      {kode:"B 0804", nama:"Lacoste Essential", harga:66000, atas:"Jeruk, Herbal, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 0903", nama:"Montblanc Legend", harga:72000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1001", nama:"Montblanc Presence", harga:66000, atas:"Jeruk, Bunga Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1004", nama:"Nautica Voyage", harga:60000, atas:"Jeruk, Air Segar, Herbal", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1105", nama:"Polo Black", harga:72000, atas:"Jeruk, Rempah, Kayu", tengah:"Bunga, Kayu Ringan", bawah:"Kayu Hitam, Ambar, Musk Lembut"},
      {kode:"B 1205", nama:"Polo Sport", harga:66000, atas:"Jeruk, Daun Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1301", nama:"Ralph Lauren Blue", harga:66000, atas:"Jeruk, Air Segar, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1403", nama:"Salvatore Ferragamo", harga:72000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1501", nama:"Versace Man", harga:72000, atas:"Jeruk, Air Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1601", nama:"Yves Saint Laurent Y", harga:84000, atas:"Jeruk, Apel, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"B 1702", nama:"YSL Opium", harga:84000, atas:"Jeruk, Rempah, Bunga", tengah:"Bunga, Kayu, Rempah", bawah:"Kayu, Ambar, Musk Manis"}
    ]
  ]
};

let halamanSekarang = 0;
let dataHalaman = dataProduk.halaman;

function bukaAroma(p){
  document.getElementById('namaProdukModal').textContent = p.nama;
  document.getElementById('aromaAtas').textContent = p.atas;
  document.getElementById('aromaTengah').textContent = p.tengah;
  document.getElementById('aromaBawah').textContent = p.bawah;
  document.getElementById('modalAroma').style.display = 'flex';
}
function tutupAroma(){
  document.getElementById('modalAroma').style.display = 'none';
}

function muatHalaman(){
  document.getElementById('namaKelompok').textContent = "🪵 KELOMPOK 3 — KAYU / WOODY";
  tampilHalaman();
}

function tampilHalaman(){
  const totalHalaman = dataHalaman.length;
  const produk = dataHalaman[halamanSekarang];
  let html = '';
  produk.forEach(p => {
    html += `<tr class="baris-produk" onclick='bukaAroma(${JSON.stringify(p).replace(/'/g,"\\'")})'>
      <td>${p.kode}</td>
      <td>${p.nama}</td>
      <td>${p.harga.toLocaleString('id-ID')}</td>
      <td style="text-align:center" onclick="event.stopPropagation()">
        <button class="btn-beli" onclick="tambahKeKeranjang('${p.nama.replace(/'/g,"\\'")}', ${p.harga})">+</button>
      </td>
    </tr>`;
  });
  document.getElementById('isiTabel').innerHTML = html;
  document.getElementById('infoHalaman').textContent = `Halaman ${halamanSekarang+1} dari ${totalHalaman}`;
  document.getElementById('btnSebelumnya').disabled = halamanSekarang <= 0;
  document.getElementById('btnSelanjutnya').disabled = halamanSekarang >= totalHalaman.length-1;
}

function halamanSebelumnya(){
  if(halamanSekarang > 0){ halamanSekarang--; tampilHalaman(); window.scrollTo({top:0,behavior:'smooth'}); }
}
function halamanSelanjutnya(){
  if(halamanSekarang < dataHalaman.length-1){ halamanSekarang++; tampilHalaman(); window.scrollTo({top:0,behavior:'smooth'}); }
}

muatHalaman();
</script>
<script src="fungsi.js"></script>
</body>
                                 </html>
    
