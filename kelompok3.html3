      {kode:"A 0801", nama:"Bvlgari Extreme", harga:78000, atas:"Jeruk, Rempah, Kayu Segar", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"A 0903", nama:"Lacoste Red", harga:60000, atas:"Jeruk, Buah Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Lembut"},
