      {kode:"A 1204", nama:"Hugo Boss Bottled", harga:78000, atas:"Jeruk, Apel, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"A 1303", nama:"Dunhill Desire Blue", harga:66000, atas:"Jeruk, Air Segar, Buah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Segar"},
      {kode:"A 1401", nama:"Paco Rabanne 1 Million", harga:90000, atas:"Jeruk, Rempah, Buah", tengah:"Bunga, Kayu, Rempah", bawah:"Kayu, Ambar, Musk Manis"},
      {kode:"A 1403", nama:"Paco Rabanne XS", harga:60000, atas:"Jeruk, Buah Segar, Rempah", tengah:"Bunga, Kayu Ringan", bawah:"Kayu, Ambar, Musk Lembut"}
    ],
    [
      {kode:"B 0101", nama:"Bvlgari Black", harga:72000, atas:"Jeruk, Rempah, Kayu", tengah:"Bunga, Kayu, Rempah", bawah:"Kayu Hitam, Ambar, Musk Lembut"},
